<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template — replace the following before installing:
    YOUR_USERNAME      = your macOS short username (output of `whoami`)
    PATH_TO_CLAUDE     = absolute path to `claude` binary (`which claude`)
    PATH_TO_REPO       = where you cloned lark-skills (e.g. /Users/YOUR_USERNAME/workspace/lark-skills)
    PATH_TO_NODE_BIN   = directory containing `claude` and `node` (e.g. /Users/YOUR_USERNAME/.local/share/mise/installs/node/22.12.0/bin)
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lark-skills.weekly-report</string>

    <key>ProgramArguments</key>
    <array>
        <string>PATH_TO_CLAUDE</string>
        <string>-p</string>
        <string>/weekly-report 本周</string>
        <string>--allowedTools</string>
        <string>Bash,Read,Write,Edit,Glob,Grep</string>
    </array>

    <key>WorkingDirectory</key>
    <string>PATH_TO_REPO</string>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>5</integer>
        <key>Hour</key>
        <integer>11</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/lark-skills-weekly-report.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/lark-skills-weekly-report.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>PATH_TO_NODE_BIN:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
    </dict>
</dict>
</plist>
