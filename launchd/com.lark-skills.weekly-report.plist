<?xml version="1.0" encoding="UTF-8"?>
<!--
  Template — replace:
    PATH_TO_REPO     = where you cloned lark-skills
    PATH_TO_NODE_BIN = directory containing claude/codex/node
    YOUR_USERNAME    = your macOS short username
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.lark-skills.weekly-report</string>

    <key>ProgramArguments</key>
    <array>
        <string>PATH_TO_REPO/launchd/run-weekly-report.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>PATH_TO_REPO</string>

    <!-- 每周一 09:00 跑;扫描上一个完整 ISO 周(上周一~上周日) -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Weekday</key>
        <integer>1</integer>
        <key>Hour</key>
        <integer>9</integer>
        <key>Minute</key>
        <integer>0</integer>
    </dict>

    <key>StandardOutPath</key>
    <string>/tmp/lark-skills-weekly-report.stdout.log</string>
    <key>StandardErrorPath</key>
    <string>/tmp/lark-skills-weekly-report.stderr.log</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>PATH_TO_NODE_BIN:/usr/local/bin:/usr/bin:/bin</string>
        <key>HOME</key>
        <string>/Users/YOUR_USERNAME</string>
        <key>LARK_SKILLS_REPO</key>
        <string>PATH_TO_REPO</string>
    </dict>
</dict>
</plist>
