# Copy to launchd/weekly-report.env and adjust locally.
# Do not commit launchd/weekly-report.env.

# Optional: choose a specific GitHub CLI account.
# If unset, run-weekly-report.sh uses the active `gh` account.
WEEKLY_REPORT_GITHUB_USER=""

# Optional: set a token directly instead of reading from `gh auth token`.
# GITHUB_TOKEN=""
# GH_TOKEN=""

# Optional binary overrides for launchd's limited PATH.
# CLAUDE_BIN="/path/to/claude"
# CODEX_BIN="/path/to/codex"
# GH_BIN="/path/to/gh"

# Optional prompt override.
# WEEKLY_REPORT_PROMPT="run weekly-report 上周。必须读取并遵循 skills/weekly-report/SKILL.md；使用完整上周 ISO 周范围；创建文档后自动 transfer owner 并重新授权 bot；投递到配置目标；追加索引。"
